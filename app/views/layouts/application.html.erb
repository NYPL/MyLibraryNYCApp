</html>

<script>
  const env = {
    MLN_INFO_SITE_HOSTNAME: "<%= ENV["MLN_INFO_SITE_HOSTNAME"] %>",
    RAILS_ENV: "<%= ENV["RAILS_ENV"] %>",
  };
</script>
