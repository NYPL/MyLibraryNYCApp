<nav class="navigation" role="navigation">
  <div class="container">
    <div class="site-logo" role="banner" class="nav-hover-color">
        <%= link_to image_tag("mylibrarynyc-logo-white-mini.png", border: 0), "//#{ENV["MLN_INFO_SITE_HOSTNAME"]}" %>
      </div>
    <ul class="nav nav--global__list float-right">
      <% if user_signed_in? %>
        <li class="nav-hover-color"><%= link_to "Account", account_url %></li>
      <% elsif user_signed_in? == false && params["host"] == ENV["MLN_INFO_SITE_HOSTNAME"] && params["controller"] == "info_site" %>
        <li class="nav-hover-color"><%= link_to "Account", "//#{ENV["MLN_INFO_SITE_HOSTNAME"]}/users/start" %></li>
      <% else %>
        <li class="nav-hover-color"><%= link_to "Sign In".html_safe, new_user_session_path %></li>
      <% end %>
      <li class="nav-hover-color"><%= link_to "Search Teacher Sets", "//#{ENV["MLN_INFO_SITE_HOSTNAME"]}/app#/teacher_sets" %></li>
      <li class="nav-hover-color"><%= link_to "Help", "//#{ENV["MLN_INFO_SITE_HOSTNAME"]}/help" %></li>
      <li class="nav-hover-color"><%= link_to "FAQs", "//#{ENV["MLN_INFO_SITE_HOSTNAME"]}/faq" %></li>
      <li class="nav-hover-color"><%= link_to "Participating Schools", "//#{ENV["MLN_INFO_SITE_HOSTNAME"]}/schools" %></li>
    </ul>
  </div>
</nav>

<div id="timeout-warning">
  Your session is about to expire.
  <span id="extend-session-link" onClick="extendSession();">Extend my session</span>.
  <iframe id="extend-session-iframe" src="/extend_session_iframe" width="100" height="100" style="display:none;">
    <!-- We reload this iframe when a user needs to extend a session. That resets -->
  </iframe>
  <script>
    function extendSession() {
      document.getElementById('extend-session-iframe').contentDocument.location.reload(true);
      $('#timeout-warning').hide();
    }
  </script>
</div>
